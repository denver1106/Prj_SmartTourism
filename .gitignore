# --- Dataset folders (ignore heavy data) ---
data/**/images/
data/**/labels/

# Ignore temporary or large archive files
*.zip
*.rar
*.tar
*.tar.gz

# --- Keep important metadata files ---
!data/**/data.yaml
!data/**/README.*

# --- Ignore Python cache, IDE files ---
__pycache__/
*.pyc
*.pyo
*.pyd
.vscode/
.idea/
.DS_Store
